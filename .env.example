# Thunspark Environment Configuration

# Django Core
SECRET_KEY=thunspark-dev-secret-key-change-in-production-2026-x9!q
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Databases & Caching
DATABASE_URL=postgres://thunspark_user:thunspark_pass@db:5432/thunspark_db
POSTGRES_DB=thunspark_db
POSTGRES_USER=thunspark_user
POSTGRES_PASSWORD=thunspark_pass
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/1

# Next.js Integration & ISR Revalidation
NEXTJS_INTERNAL_URL=http://frontend:3000
NEXTJS_REVALIDATE_SECRET=thunspark-revalidate-secret-token-4821

# Next.js Frontend Configuration
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=GTM-THUNSPARK
REVALIDATE_SECRET=thunspark-revalidate-secret-token-4821
PREVIEW_SECRET=thunspark-preview-secret-key-9912

# Transactional Email (Resend)
RESEND_API_KEY=re_dev_placeholder_key
DEFAULT_FROM_EMAIL=Thunspark <leads@thunspark.agency>
NOTIFICATION_RECIPIENT_EMAIL=team@thunspark.agency

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
