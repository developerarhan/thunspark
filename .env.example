# ThunSpark Digital Growth Agency - Environment Variables Example
# See frontend/.env.example for details.

# Site URLs
NEXT_PUBLIC_SITE_URL=https://www.thunspark.agency
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_BOOKING_URL=https://cal.com/thunspark/strategy

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Upstash Redis / Vercel KV
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
ENQUIRY_HASH_SALT=your_random_cryptographic_salt_here

# Resend Email Delivery
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ThunSpark Inquiries <inquiries@thunspark.agency>
ENQUIRY_NOTIFICATION_EMAIL=hello@thunspark.agency
